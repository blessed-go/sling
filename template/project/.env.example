# Application environment (local, staging, production)
APP_ENV=local

# Configuration file location (optional override; by default each service loads conf/<service>.toml)
# CONFIG_PATH=conf/conf.toml

# Host user and group IDs for container volume permissions
UID=1000
GID=1000

# Remote Delve debugger port overrides (format: <SERVICE>_DELVE_PORT)
# Uncomment and change if the default allocated port is already in use locally
# BOOKING_DELVE_PORT=2345
# BILLING_DELVE_PORT=2346

