meta {
  name: Create Item
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/__SERVICE__/v1/items
  body: json
  auth: none
}

body:json {
  {
    "title": "Smoke Test Room"
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.title: eq Smoke Test Room
}

script:post-response {
  bru.setVar("created_id", res.body.id);
}
